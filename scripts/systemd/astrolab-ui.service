[Unit]
Description=astrolab UI (SvelteKit / Vite dev server)
After=network-online.target astrolab-api.service
Wants=network-online.target
PartOf=astrolab-api.service

[Service]
Type=simple
User=bscholer
Group=bscholer
WorkingDirectory=/home/bscholer/projects/astrolab/ui
Environment=PATH=/usr/bin:/bin:/usr/local/bin
ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0 --port 5173
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/astrolab-ui.log
StandardError=append:/var/log/astrolab-ui.log

[Install]
WantedBy=multi-user.target
