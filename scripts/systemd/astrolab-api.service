[Unit]
Description=astrolab API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/scratch

[Service]
Type=simple
User=bscholer
Group=bscholer
WorkingDirectory=/home/bscholer/projects/astrolab
Environment=ASTROLAB_HOME=/scratch/astrolab
Environment=PATH=/home/bscholer/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/bscholer/projects/astrolab/.venv/bin/uvicorn server.api:app --host 0.0.0.0 --port 8000 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/astrolab-api.log
StandardError=append:/var/log/astrolab-api.log

[Install]
WantedBy=multi-user.target
