[Unit]
Description=astrolab on-push deploy (pull main, build, restart api)
After=network-online.target
Wants=network-online.target

[Service]
# oneshot: runs to completion, no port to listen on. Triggered by the
# /api/_deploy webhook via `sudo systemctl start --no-block`. Lives in
# its own cgroup so restarting astrolab-api inside the script doesn't
# kill us mid-deploy.
Type=oneshot
User=bscholer
Group=bscholer
WorkingDirectory=/home/bscholer/projects/astrolab
Environment=PATH=/home/bscholer/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/bscholer/projects/astrolab/scripts/deploy-on-box.sh
StandardOutput=append:/var/log/astrolab-deploy.log
StandardError=append:/var/log/astrolab-deploy.log
TimeoutStartSec=600
